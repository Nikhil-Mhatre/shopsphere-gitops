{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "replicaCount",
    "image",
    "service",
    "container",
    "config",
    "database",
    "secret",
    "resources",
    "serviceAccount"
  ],

  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },

    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },

    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "nameOverride": {
      "type": "string"
    },

    "fullnameOverride": {
      "type": "string"
    },

    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "automount"],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "automount": {
          "type": "boolean"
        }
      }
    },

    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port", "targetPort"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "targetPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },

    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },

    "config": {
      "type": "object"
    },

    "database": {
      "type": "object"
    },

    "secret": {
      "type": "object"
    },

    "resources": {
      "type": "object"
    },

    "podSecurityContext": {
      "type": "object"
    },

    "containerSecurityContext": {
      "type": "object"
    },

    "nodeSelector": {
      "type": "object"
    },

    "affinity": {
      "type": "object"
    },

    "tolerations": {
      "type": "array"
    },

    "podAnnotations": {
      "type": "object"
    },

    "podLabels": {
      "type": "object"
    },

    "deployment": {
      "type": "object"
    },

    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },

    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },

    "probes": {
      "type": "object"
    }
  }
}
